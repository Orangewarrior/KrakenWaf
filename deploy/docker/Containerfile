# KrakenWaf — hardened OCI image (CIS Docker Benchmark aligned)
# ─────────────────────────────────────────────────────────────────────────────
# Multi-stage build:
#   * builder — compiles the release binary (needs a C toolchain for the
#     vendored libinjection + bundled SQLite).
#   * runtime — Debian bookworm-slim with only runtime libraries installed,
#     running as a dedicated non-root user.
#
# Build:  docker build -f deploy/docker/Containerfile -t krakenwaf:bookworm-slim .
# Run:    docker run --rm -p 8443:8443 -p 4343:4343 -p 4342:4342 \
#           --read-only --cap-drop ALL --security-opt no-new-privileges \
#           --tmpfs /tmp --tmpfs /var/lib/krakenwaf --tmpfs /var/log/krakenwaf \
#           -v "$PWD/certs:/etc/krakenwaf/certs:ro" \
#           -v "$PWD/secrets/BEARER_PASSWORD:/run/secrets/krakenwaf/BEARER_PASSWORD:ro" \
#           -v "$PWD/secrets/RORSCHACH_SECRET_EVEN:/run/secrets/krakenwaf/RORSCHACH_SECRET_EVEN:ro" \
#           -v "$PWD/secrets/RORSCHACH_SECRET_ODD:/run/secrets/krakenwaf/RORSCHACH_SECRET_ODD:ro" \
#           krakenwaf:bookworm-slim
#
# TLS material is NOT baked into the image. Mount your CA-issued certificate and
# key as certs/cert.pem and certs/key.pem (the paths rules/tls/sni_map.csv
# references). For a throwaway local pair: scripts/gen-dev-certs.sh.
#
# The WAF runs with no CLI flags: it auto-discovers conf/ and rules/ under its
# working directory (/etc/krakenwaf) and reads listen / metrics-port /
# rule_management_port from conf/proxy.yaml.
#
# Secrets are resolved file-first from /run/secrets/krakenwaf/<NAME> (preferred).
# The legacy <NAME>_FILE / plain <NAME> env vars are also accepted but leak via
# /proc/<pid>/environ — see deploy/README.md and docs/secrets.md. Port 4342 is
# the rule-management control plane (only opens with both RORSCHACH_SECRET_*).

# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM docker.io/library/rust:1.90-bookworm AS builder

# A C compiler is required by build.rs (libinjection) and rusqlite (bundled).
RUN apt-get update \
    && apt-get install -y --no-install-recommends clang \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Leverage layer caching: copy manifests first, fetch deps, then sources.
COPY Cargo.toml Cargo.lock ./
COPY build.rs ./
COPY ffi ./ffi
COPY src ./src

# Build a stripped release binary. CARGO_NET_RETRY hardens flaky CI networks.
# --locked makes the committed Cargo.lock authoritative so the image build can
# never silently pull a different (e.g. poisoned) transitive dependency version.
ENV CARGO_NET_RETRY=5
RUN cargo build --release --locked --bin krakenwaf \
    && strip target/release/krakenwaf

# ── Stage 2: runtime (Debian slim, non-root) ─────────────────────────────────
FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgcc-s1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --home-dir /home/kraken kraken

LABEL org.opencontainers.image.title="KrakenWaf" \
      org.opencontainers.image.description="TLS-aware Rust Web Application Firewall" \
      org.opencontainers.image.source="https://github.com/Orangewarrior/KrakenWaf" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /etc/krakenwaf

# Binary.
COPY --from=builder /build/target/release/krakenwaf /usr/local/bin/krakenwaf

# Default config + rules + block page baked in (override via volumes/ConfigMaps).
COPY --chown=kraken:kraken conf  ./conf
COPY --chown=kraken:kraken rules ./rules
COPY --chown=kraken:kraken alert ./alert

# Writable state + logs. Mount these as tmpfs / emptyDir at runtime so the root
# filesystem can stay read-only.
USER kraken:kraken
VOLUME ["/var/lib/krakenwaf", "/var/log/krakenwaf", "/tmp"]

# 8443 data plane · 4343 observability/metrics · 4342 rule-management control plane.
EXPOSE 8443 4343 4342

# Image-level healthcheck hits the liveness probe. (Kubernetes uses its own
# httpGet probes; this benefits plain `docker run` / compose.)
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/krakenwaf", "config", "validate"]

# No CLI flags: from WORKDIR /etc/krakenwaf the WAF auto-discovers conf/proxy.yaml
# (listen, metrics-port, rule_management_port, upstream, …), conf/ratelimit.yaml,
# conf/websocket.yaml and ./rules. Override any path with a flag if you relocate
# the config (e.g. `docker run ... krakenwaf:bookworm-slim --external-proxy-conf=/x.yaml`).
ENTRYPOINT ["/usr/local/bin/krakenwaf"]
CMD []
