FROM docker.io/library/rust:1.95-alpine AS builder

# musl/Alpine build toolchain. build-base+musl-dev (cc) cover the vendored
# libinjection (build.rs) and the bundled SQLite; cmake/perl/go are required by
# aws-lc-sys (pulled in via rustls' default features); clang/llvm + LIBCLANG_PATH
# satisfy bindgen; git clones kraken-ui.
RUN apk add --no-cache \
        build-base musl-dev linux-headers \
        cmake make perl go bash \
        clang clang-dev llvm-dev \
        git pkgconfig openssl-dev
ENV LIBCLANG_PATH=/usr/lib

WORKDIR /build/krakenwaf
COPY Cargo.toml Cargo.lock build.rs ./
COPY ffi ./ffi
COPY src ./src
RUN cargo build --release --locked --bin krakenwaf

ARG KRAKEN_UI_REF=c5b81e6f5bd339e9f87110fd11857518e1ab738d
RUN git clone https://github.com/Orangewarrior/kraken-ui.git /build/kraken-ui \
    && cd /build/kraken-ui \
    && git checkout --detach "${KRAKEN_UI_REF}" \
    && cargo build --release --locked --bin kraken-ui

FROM docker.io/library/alpine:3.21

RUN apk add --no-cache ca-certificates curl openssl \
    && addgroup -g 10001 kraken \
    && adduser -D -u 10001 -G kraken -h /home/kraken kraken

COPY --from=builder /build/krakenwaf/target/release/krakenwaf /usr/local/bin/krakenwaf
COPY --from=builder /build/kraken-ui/target/release/kraken-ui /usr/local/bin/kraken-ui
COPY --from=builder /build/kraken-ui/src/view/static /build/kraken-ui/src/view/static
COPY conf /opt/krakenwaf/conf
COPY rules /opt/krakenwaf/rules
COPY alert /opt/krakenwaf/alert
COPY certs /opt/krakenwaf/certs
COPY deploy/WAF_n_WEB_UI/ui/setup.yaml /opt/kraken-ui/conf/setup.yaml
COPY deploy/WAF_n_WEB_UI/ui/ratelimit.yaml /opt/kraken-ui/conf/ratelimit.yaml
COPY deploy/WAF_n_WEB_UI/entrypoint.sh /usr/local/bin/waf-ui-entrypoint

RUN chmod 0755 /usr/local/bin/waf-ui-entrypoint \
    && mkdir -p /opt/krakenwaf/certs /opt/krakenwaf/logs/db /opt/kraken-ui/db /opt/kraken-ui/log \
    && { { [ -s /opt/krakenwaf/certs/cert.pem ] && [ -s /opt/krakenwaf/certs/key.pem ]; } \
        || openssl req -x509 -nodes -days 365 -newkey rsa:4096 \
            -keyout /opt/krakenwaf/certs/key.pem \
            -out /opt/krakenwaf/certs/cert.pem \
            -config /opt/krakenwaf/rules/tls/localhost.cnf; } \
    && chmod 600 /opt/krakenwaf/certs/key.pem \
    && chown -R kraken:kraken /opt/krakenwaf /opt/kraken-ui /build/kraken-ui

USER kraken
WORKDIR /opt/krakenwaf
EXPOSE 8443 3443 4343 4342
VOLUME ["/opt/krakenwaf/logs", "/opt/kraken-ui/db", "/opt/kraken-ui/log"]
ENTRYPOINT ["/usr/local/bin/waf-ui-entrypoint"]
