[Unit]
Description=KrakenWaf — TLS-aware Rust Web Application Firewall
Documentation=https://github.com/Orangewarrior/KrakenWaf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── Identity ─────────────────────────────────────────────────────────────────
# Run as a dedicated, unprivileged service account. Create it once with:
#   useradd --system --no-create-home --shell /usr/sbin/nologin krakenwaf
User=krakenwaf
Group=krakenwaf

# ── Binary & working directory ───────────────────────────────────────────────
# WorkingDirectory holds conf/, rules/, certs/, alert/ and the writable state.
WorkingDirectory=/var/lib/krakenwaf
ExecStart=/usr/local/bin/krakenwaf \
    --external-proxy-conf /var/lib/krakenwaf/conf/proxy.yaml \
    --ratelimit-by-file-conf /var/lib/krakenwaf/conf/ratelimit.yaml \
    --websocket-conf /var/lib/krakenwaf/conf/websocket.yaml \
    --rules-dir /var/lib/krakenwaf/rules

# Pre-flight: fail the unit before binding ports if any config is invalid.
ExecStartPre=/usr/local/bin/krakenwaf config validate \
    --external-proxy-conf /var/lib/krakenwaf/conf/proxy.yaml \
    --ratelimit-by-file-conf /var/lib/krakenwaf/conf/ratelimit.yaml \
    --websocket-conf /var/lib/krakenwaf/conf/websocket.yaml \
    --rules-dir /var/lib/krakenwaf/rules

# Graceful reload (SIGHUP hot-reloads rules + TLS certs).
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=2s
TimeoutStopSec=35s

# ── Secrets (file-first; never via Environment=) ─────────────────────────────
# systemd places credentials in $CREDENTIALS_DIRECTORY (a tmpfs, 0400, owned by
# the service user). KrakenWaf resolves <NAME>_FILE first, so point it there.
# Provision the source files readable only by root (0400).
LoadCredential=REDIS_PASSWORD:/etc/krakenwaf/secrets/REDIS_PASSWORD
Environment=REDIS_PASSWORD_FILE=%d/REDIS_PASSWORD

# ── Hardening (CIS / systemd security sandbox) ───────────────────────────────
# Privilege & capability containment. The WAF needs CAP_NET_BIND_SERVICE only
# when it binds a privileged port (<1024); drop everything else.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SecureBits=keep-caps

# Filesystem isolation: read-only system, private /tmp, hidden /home, and an
# explicit writable allow-list for state + logs only.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/krakenwaf /var/log/krakenwaf

# Kernel / device / namespace lockdown.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=true
DevicePolicy=closed
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true
KeyringMode=private
UMask=0077

# Address-family & syscall allow-listing.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @cpu-emulation @debug @mount @swap @reboot @raw-io

# ── Resource limits (anti-DoS belt-and-braces) ───────────────────────────────
LimitNOFILE=131072
TasksMax=4096
MemoryMax=2G

[Install]
WantedBy=multi-user.target
