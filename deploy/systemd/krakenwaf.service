[Unit]
Description=KrakenWaf — TLS-aware Rust Web Application Firewall
Documentation=https://github.com/Orangewarrior/KrakenWaf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── Identity ─────────────────────────────────────────────────────────────────
# Run as a dedicated, unprivileged service account. Create it once with:
#   useradd --system --no-create-home --shell /usr/sbin/nologin krakenwaf
User=krakenwaf
Group=krakenwaf

# ── Binary & working directory ───────────────────────────────────────────────
# WorkingDirectory holds conf/, rules/, certs/, alert/ and the writable state.
WorkingDirectory=/var/lib/krakenwaf
ExecStart=/usr/local/bin/krakenwaf \
    --external-proxy-conf /var/lib/krakenwaf/conf/proxy.yaml \
    --ratelimit-by-file-conf /var/lib/krakenwaf/conf/ratelimit.yaml \
    --websocket-conf /var/lib/krakenwaf/conf/websocket.yaml \
    --rules-dir /var/lib/krakenwaf/rules

# Pre-flight: fail the unit before binding ports if any config is invalid.
ExecStartPre=/usr/local/bin/krakenwaf config validate \
    --external-proxy-conf /var/lib/krakenwaf/conf/proxy.yaml \
    --ratelimit-by-file-conf /var/lib/krakenwaf/conf/ratelimit.yaml \
    --websocket-conf /var/lib/krakenwaf/conf/websocket.yaml \
    --rules-dir /var/lib/krakenwaf/rules

# Graceful reload (SIGHUP hot-reloads rules + TLS certs).
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=2s
TimeoutStopSec=35s

# ── Secrets (file-first; never via Environment=) ─────────────────────────────
# systemd places credentials in $CREDENTIALS_DIRECTORY (a tmpfs, 0400, owned by
# the service user). KrakenWaf resolves <NAME>_FILE first, so point it there.
# Provision the source files readable only by root (0400).
LoadCredential=REDIS_PASSWORD:/etc/krakenwaf/secrets/REDIS_PASSWORD
Environment=REDIS_PASSWORD_FILE=%d/REDIS_PASSWORD
# Bearer token for the dedicated observability port (/metrics, health probes,
# kraken-ui). Resolved file-first via BEARER_PASSWORD_FILE, so it is
# never passed in plaintext via Environment= and never hard-coded. Generate the
# source file once (e.g. `openssl rand -hex 32 > .../BEARER_PASSWORD`),
# owned by root, mode 0400. Omit both lines to leave the port IP-allowlist-only.
LoadCredential=BEARER_PASSWORD:/etc/krakenwaf/secrets/BEARER_PASSWORD
Environment=BEARER_PASSWORD_FILE=%d/BEARER_PASSWORD
# Rorschach secrets for the rule-management control plane (/rule/control/cmc/*,
# default port 4342). Both must be base64url (no padding) of >= 64 random bytes.
# Resolved file-first via RORSCHACH_SECRET_*_FILE (an env var that points at the
# tmpfs credential), so the key material itself is never placed in Environment=.
# Generate each source file once, owned by root, mode 0400:
#   openssl rand -base64 64 | tr '+/' '-_' | tr -d '=\n' \
#     > /etc/krakenwaf/secrets/RORSCHACH_SECRET_EVEN
#   openssl rand -base64 64 | tr '+/' '-_' | tr -d '=\n' \
#     > /etc/krakenwaf/secrets/RORSCHACH_SECRET_ODD
# Both must be present or the control plane stays disabled; a provisioned-but-
# invalid secret is fail-closed (the unit will not start). Omit all four lines
# to leave the rule-management API off.
LoadCredential=RORSCHACH_SECRET_EVEN:/etc/krakenwaf/secrets/RORSCHACH_SECRET_EVEN
Environment=RORSCHACH_SECRET_EVEN_FILE=%d/RORSCHACH_SECRET_EVEN
LoadCredential=RORSCHACH_SECRET_ODD:/etc/krakenwaf/secrets/RORSCHACH_SECRET_ODD
Environment=RORSCHACH_SECRET_ODD_FILE=%d/RORSCHACH_SECRET_ODD

# ── Hardening (CIS / systemd security sandbox) ───────────────────────────────
# Privilege & capability containment. The WAF needs CAP_NET_BIND_SERVICE only
# when it binds a privileged port (<1024); drop everything else.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SecureBits=keep-caps

# Filesystem isolation: read-only system, private /tmp, hidden /home, and an
# explicit writable allow-list for state + logs only.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/krakenwaf /var/log/krakenwaf

# Kernel / device / namespace lockdown.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=true
DevicePolicy=closed
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true
KeyringMode=private
UMask=0077

# Address-family & syscall allow-listing.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @cpu-emulation @debug @mount @swap @reboot @raw-io

# ── Resource limits (anti-DoS belt-and-braces) ───────────────────────────────
LimitNOFILE=131072
TasksMax=4096
MemoryMax=2G

[Install]
WantedBy=multi-user.target
